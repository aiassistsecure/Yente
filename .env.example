# ── ONE DATABASE, ONE PROCESS ─────────────────────────────────────────────
# There used to be two directories: this one for the member ledger and
# YENTE_WAITLIST_DATA_PATH for subscribers, because the engine takes an
# exclusive lock per directory and exposes no close, so the web process could
# not share the daemon's store.
#
# The cost was product, not tidiness: somebody who joined on the site was a
# subscriber in one database and somebody who emailed was a member in the
# other, with nothing joining them. The funnel never reached the desk, and the
# weekly letter sequence could not run at all — a letter has to read
# subscribers AND write to the outbox.
#
# bin/daemon.mjs now owns this directory and serves the web surface itself. If
# YENTE_WAITLIST_DATA_PATH is still set to something else the daemon refuses to
# start; migrate the old subscribers across first:
#
#   node bin/migrate-waitlist.mjs ./data/waitlist            # dry run
#   node bin/migrate-waitlist.mjs ./data/waitlist --commit
YENTE_DATA_PATH=./data/yente

# The BFF, served from the daemon. Set YENTE_HTTP=0 to run mail-only (a second
# box, or while debugging the desk without exposing a port).
YENTE_HTTP=1

# Admin routes fail closed when either value is missing.
YENTE_ADMIN_USERNAME=change-me
YENTE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Bind to loopback behind nginx. Set YENTE_TRUST_PROXY=1 only for your proxy.
YENTE_HOST=127.0.0.1
YENTE_PORT=3000
YENTE_TRUST_PROXY=1

# ── The mailbox (Mail-in-a-Box) ───────────────────────────────────────────
# Yente's inbox IS the product, so these are what make her real. Create the
# mail user first in the MiaB admin panel: Mail > Users > Add a mail user.
# Adding a user for a new domain is what makes MiaB host that domain; there is
# no separate "add domain" step.
#
# USER MUST BE THE FULL ADDRESS. MiaB rejects a bare "yente", and that is the
# single most common auth failure against it.
YENTE_MAIL_HOST=box.electronero.org
YENTE_MAIL_USER=yente@ccme.network
YENTE_MAIL_PASS=
YENTE_FROM=Yente <yente@ccme.network>
YENTE_MAILBOX=INBOX

# 993 is implicit TLS. 587 is submission, where the connection starts plain and
# upgrades via STARTTLS — the transport sets secure:false there, which means
# "upgrade", NOT "send in the clear". Setting it true instead hangs the
# connection, and nothing in the naming warns you.
YENTE_IMAP_PORT=993
YENTE_SMTP_PORT=587

# ── The model that reads résumés and writes her letters ───────────────────
# WITHOUT THESE THE DESK IS MUTE. createRuntime defaults extractionClient and
# emailClient to null and gates all extraction on `if (extractionClient)`, so a
# missing model looks exactly like success: ingested=1, sent=0, no error.
#
# pin    AiAS gateway -> PIN peer network, model muse-local:latest (DEFAULT).
#        Not third-party — our own network — so /privacy still holds. This is
#        also the path that EXISTS: `local` was the old default and nothing
#        listens on 127.0.0.1:8080 in production, so the "safe" default
#        guaranteed a NETWORK_ERROR on the first résumé.
#
#        muse-local is a REASONING model and emits no stream chunks while it
#        thinks — 82 SECONDS of pin_latency measured on a real extraction
#        prompt. The gateway kills a stream after 90s of SILENCE BETWEEN
#        CHUNKS, so the client's first-token deadline sits at 100s to let the
#        upstream explain itself rather than timing out first. If extraction
#        still reports UPSTREAM_ERROR "operator produced nothing for 90s", the
#        fix is operator-side: cap thinking (Ollama `think: false` on
#        /api/chat, which the OpenAI-compatible path cannot carry), and drop
#        the Modelfile's `temperature 0.9` / `top_p 0.95` — those are
#        creative-writing settings that lengthen the trace and, measured, beat
#        the request's temperature 0, which makes extraction non-reproducible.
#
# local  llama.cpp on our own box. The only other option consistent with
#        what /privacy currently promises.
# aias   AiAssist Secure. Set YENTE_LLM_UPSTREAM (groq|anthropic|openai|pin).
# pin    PIN network via AiAS — our own network, so not third party.
YENTE_LLM_PROVIDER=local
YENTE_LLM_BASE_URL=http://127.0.0.1:8080/v1
YENTE_LLM_API_KEY=
YENTE_LLM_UPSTREAM=

# THE TWO MODEL VARS — and only two (YENTE_MODEL / YENTE_LLM_MODEL are retired
# and fail the boot with instructions; three aliases for one knob is how a box
# serves a model nobody remembers choosing):
#   YENTE_MODEL_DOCUMENT  the heavyweight read (résumés, attachments) and the
#                         default for everything
#   YENTE_MODEL_MESSAGE   short bodies; optional, defaults to the document model
YENTE_MODEL_DOCUMENT=
YENTE_MODEL_MESSAGE=

# Verified working 2026-08-13: 5 grounded facts, 0 rejected, first attempt.
#   YENTE_LLM_PROVIDER=aias
#   YENTE_LLM_UPSTREAM=anthropic
#   YENTE_MODEL_DOCUMENT=claude-sonnet-5
#   YENTE_LLM_API_KEY=aai_...
# ALWAYS set an explicit model on aias: the account default (claude-fable-5)
# 400s because the groq fallback keeps the anthropic model name.
