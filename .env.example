# Dedicated durable NEDB v2 DAG for public waitlist records.
# Use an absolute path on the VPS; do not reuse Yente's core database directory.
YENTE_WAITLIST_DATA_PATH=./data/waitlist

# Admin routes fail closed when either value is missing.
YENTE_ADMIN_USERNAME=change-me
YENTE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Bind to loopback behind nginx. Set YENTE_TRUST_PROXY=1 only for your proxy.
YENTE_HOST=127.0.0.1
YENTE_PORT=3000
YENTE_TRUST_PROXY=1

# ── The mailbox (Mail-in-a-Box) ───────────────────────────────────────────
# Yente's inbox IS the product, so these are what make her real. Create the
# mail user first in the MiaB admin panel: Mail > Users > Add a mail user.
# Adding a user for a new domain is what makes MiaB host that domain; there is
# no separate "add domain" step.
#
# USER MUST BE THE FULL ADDRESS. MiaB rejects a bare "yente", and that is the
# single most common auth failure against it.
YENTE_MAIL_HOST=box.electronero.org
YENTE_MAIL_USER=yente@ccme.network
YENTE_MAIL_PASS=
YENTE_FROM=Yente <yente@ccme.network>
YENTE_MAILBOX=INBOX

# 993 is implicit TLS. 587 is submission, where the connection starts plain and
# upgrades via STARTTLS — the transport sets secure:false there, which means
# "upgrade", NOT "send in the clear". Setting it true instead hangs the
# connection, and nothing in the naming warns you.
YENTE_IMAP_PORT=993
YENTE_SMTP_PORT=587

# The durable core database for the desk. MUST be a different directory from
# YENTE_WAITLIST_DATA_PATH: the engine takes an exclusive lock per directory and
# exposes no close, so one process cannot hold both.
YENTE_DATA_PATH=./data/yente
